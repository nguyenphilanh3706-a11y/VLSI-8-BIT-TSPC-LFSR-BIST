// DFF_MS.scs - LOP CHUYEN DOI giua LFSR cua TV4 va flip-flop cua TV1.
// Khoi MS_LFSR_8bit cua TV4 chi goi ten co dinh nay:
//     DFF_MS   (D CLK CLKB SET RST Q VDD GND)   SET/RST tich cuc cao, bat dong bo
// HIEN TAI tro toi flip-flop tam cua TV4 (cells/DFF_MS_TMP). Khi TV1 nop cell:
//   1. include netlist cua TV1 trong cells/cells.scs
//   2. sua dong instance ben duoi cho dung ten cell va THU TU CHAN (them inverter neu reset tich cuc thap)
simulator lang=spectre

subckt DFF_MS D CLK CLKB SET RST Q VDD GND
    X0 (D CLK CLKB SET RST Q VDD GND) DFF_MS_TMP
    // X0 (D CLK CLKB SET RST Q QB VDD GND) MS_DFF_SetReset    // <- cell cua TV1 (kiem tra lai thu tu chan)
ends DFF_MS
